<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Material3.CardView.Outlined"
    android:backgroundTint="@color/md_theme_onPrimaryContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        app:cardCornerRadius="30dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/md_theme_primaryContainer"
        app:strokeColor="@color/md_theme_error"
        app:strokeWidth="1dp"

        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:padding="5dp"
            android:layout_height="match_parent">
            <TextView
                android:paddingHorizontal="10sp"
                app:layout_constraintRight_toLeftOf="@id/eventShowerText"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:id="@+id/emotionShowerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😀"
                android:textSize="50sp"
                />
            <TextView
                android:textAppearance="@style/TextAppearance.MoodNote.Headline"
                app:layout_constraintLeft_toRightOf="@id/emotionShowerText"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/eventShowerText"
                android:layout_width="0dp"
                android:lines="2"
                android:textSize="25sp"
                android:ellipsize="end"
                android:text="eventeventeventevent eventevent"
                android:layout_height="wrap_content">

            </TextView>
            <TextView
                android:textAppearance="@style/TextAppearance.MoodNote.Body"
                android:id="@+id/dateShowerText"
                app:layout_constraintTop_toBottomOf="@id/eventShowerText"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@id/emotionShowerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09/09/2009 9:09">
            </TextView>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:backgroundTint="@color/md_theme_errorContainer"
                android:id="@+id/removeNoteElementButton"
                android:src="@drawable/baseline_cancel_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </com.google.android.material.floatingactionbutton.FloatingActionButton>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>