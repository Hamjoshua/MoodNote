<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.FilterFragment">

    <!-- TODO: Update blank fragment layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/eventEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Событие"
            android:inputType="text"
            android:minHeight="50dp"
            android:textAppearance="@style/TextAppearance.MoodNote.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/dateFromButton"
                style="@style/Widget.AppCompat.Spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="01/01/2022"
                android:textAppearance="@style/TextAppearance.MoodNote.Body"></Button>

            <Button
                android:id="@+id/dateToButton"
                style="@style/Widget.AppCompat.Spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="25/01/2022"
                android:textAppearance="@style/TextAppearance.MoodNote.Body"></Button>

        </LinearLayout>


        <Spinner
            android:id="@+id/emotionSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:textAppearance="@style/TextAppearance.MoodNote.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:backgroundTint="@color/md_theme_tertiary"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:textAppearance="@style/TextAppearance.MoodNote.Body"
                android:id="@+id/applyButton"
                android:layout_weight="5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Save" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:backgroundTint="@color/md_theme_tertiaryContainer"
                android:id="@+id/clearFilterButton"
                android:src="@drawable/baseline_filter_alt_off_24"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </com.google.android.material.floatingactionbutton.FloatingActionButton>

        </LinearLayout>


    </LinearLayout>

</FrameLayout>