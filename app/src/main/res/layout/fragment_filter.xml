<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.FilterFragment">

    <!-- TODO: Update blank fragment layout -->
    <LinearLayout
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <EditText
            android:minHeight="50dp"
            android:textAppearance="@style/TextAppearance.MoodNote.Body"
            android:inputType="text"
            android:id="@+id/eventEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Событие" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:textAppearance="@style/TextAppearance.MoodNote.Body"
                android:hint="01/01/2022"
                android:id="@+id/dateFromButton"
                android:layout_weight="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.AppCompat.Spinner">
            </Button>
            <Button
                android:textAppearance="@style/TextAppearance.MoodNote.Body"
                android:hint="25/01/2022"
                android:layout_weight="1"
                android:id="@+id/dateToButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.AppCompat.Spinner">
            </Button>

        </LinearLayout>


        <Spinner
            android:minHeight="50dp"
            android:textAppearance="@style/TextAppearance.MoodNote.Body"
            android:id="@+id/emotionSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:textAppearance="@style/TextAppearance.MoodNote.Body"
            android:id="@+id/applyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save" />

        <Button
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:textAppearance="@style/TextAppearance.MoodNote.Body"
            android:id="@+id/clearFilterButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear" />


    </LinearLayout>

</FrameLayout>