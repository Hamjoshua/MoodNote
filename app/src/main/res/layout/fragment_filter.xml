<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.FilterFragment">


    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Фильтры">


    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/md_theme_secondaryContainer"
        app:cardCornerRadius="30dp"
        app:strokeColor="@color/cardview_shadow_start_color"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/applyButton"
                style="@style/TextAppearance.Material3.SearchView"
                android:id="@+id/eventEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Какое событие хотите найти?"
                android:inputType="text"
                android:textAppearance="@style/TextAppearance.MoodNote.Body" />

            <com.google.android.material.button.MaterialButton
                app:layout_constraintTop_toTopOf="@id/eventEditText"
                app:layout_constraintRight_toLeftOf="@id/accordionButton"
                android:id="@+id/applyButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:backgroundTint="@color/md_theme_tertiary"
                app:icon="@drawable/baseline_search_24"
                android:textAppearance="@style/TextAppearance.MoodNote.Body" />

            <com.google.android.material.button.MaterialButton
                app:layout_constraintTop_toTopOf="@id/eventEditText"
                app:layout_constraintRight_toRightOf="parent"
                android:id="@+id/accordionButton"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/baseline_expand_more_24"
                app:iconGravity="end" />

            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/eventEditText"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerLowest"
                android:id="@+id/filterContent"
                app:cardCornerRadius="30dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/dateFromLabel"
                        style="@style/TextAppearance.MoodNote.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="От"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"></TextView>

                    <Button
                        android:id="@+id/dateFromButton"
                        android:textStyle="bold"
                        android:textColor="@color/design_default_color_primary"
                        style="@style/Widget.AppCompat.Spinner"
                        android:layout_width="0dp"

                        android:layout_height="wrap_content"
                        android:hint="01/01/2022"
                        android:textAppearance="@style/TextAppearance.MoodNote.Body"
                        app:layout_constraintRight_toLeftOf="@id/dateToButton"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/dateFromLabel"></Button>


                    <TextView
                        android:id="@+id/dateToLabel"
                        style="@style/TextAppearance.MoodNote.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="До"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <Button
                        android:id="@+id/dateToButton"

                        android:textStyle="bold"
                        android:textColor="@color/design_default_color_primary"

                        style="@style/Widget.AppCompat.Spinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="25/01/2022"
                        android:textAppearance="@style/TextAppearance.MoodNote.Body"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintLeft_toLeftOf="@id/dateToLabel"
                        app:layout_constraintTop_toBottomOf="@id/dateFromLabel"></Button>

                    <TextView
                        android:id="@+id/emotionChooseLabel"
                        style="@style/TextAppearance.MoodNote.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Эмоция"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/dateToButton" />

                    <Spinner
                        android:id="@+id/emotionSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        app:layout_constraintTop_toBottomOf="@id/emotionChooseLabel"
                        android:textAppearance="@style/TextAppearance.MoodNote.Body" />

                    <com.google.android.material.button.MaterialButton
                        app:icon="@drawable/baseline_filter_alt_off_24"
                        android:id="@+id/clearFilterButton"
                        android:backgroundTint="@color/md_theme_onErrorContainer"
                        android:text="Очистить фильтр"
                        app:layout_constraintTop_toBottomOf="@id/emotionSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </com.google.android.material.button.MaterialButton>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


</FrameLayout>